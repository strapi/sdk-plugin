{
  "name": "@strapi/plugin-custom-admin-test",
  "version": "1.0.0",
  "description": "Test plugin declaring a custom ./admin export next to ./strapi-server",
  "type": "commonjs",
  "exports": {
    "./strapi-server": {
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./admin": {
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "default": "./dist/admin/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "strapi": {
    "name": "@strapi/plugin-custom-admin-test",
    "displayName": "Custom Admin Export Test Plugin",
    "description": "Test plugin declaring a custom ./admin export",
    "kind": "plugin"
  }
}
